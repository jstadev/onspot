# OnSpot: every environment variable that the code reads. Names only, no values.
# Each line gives the default and the meaning. README.md ("Configuration") has the same table.
# The units in deploy/ set what this deployment needs. Never put a secret here.

# --- Server (server/src/index.js)
# Default 4750. Port on 127.0.0.1; an integer from 0 to 65535 (0 takes a free port).
PORT=
# Default <repo>/data/pins.db. The SQLite file; the server creates its folder.
PINS_DB=
# Default "shots" next to the database. Folder for the before and after images.
PINS_SHOTS_DIR=
# Default "images" next to the database. Folder for the images that you attach to pins and replies.
PINS_IMAGES_DIR=
# Default <repo>/extension/dist. Folder with the two extension ZIPs for /download/.
PINS_DOWNLOAD_DIR=
# Default koglabs.com. A pin URL must be https on this domain or a subdomain.
PINS_ROOT_DOMAIN=
# Default https://ai.koglabs.com/triad?tab=pins. Where "GET /" redirects (the queue UI).
PINS_QUEUE_URL=

# --- CLI (server/bin/pins.js, server/src/facts.js, ship.js, snap.js)
# Default 4750. Port of the server on 127.0.0.1. The runner and e2e read it too.
PINS_PORT=
# Default agent. The agent name that the CLI sends (X-Pins-Agent).
PINS_AGENT=
# Default /var/lib/onspot-runner/facts. What "pins snap" and "pins check" measured.
# Use the same value for the runner and for every shell that runs "pins".
PINS_FACTS_DIR=
# Default /run/lock/onspot. Lane locks and gate markers of "pins ship".
PINS_LOCK_DIR=
# Default /srv/design-kit/node_modules/playwright-core/index.mjs. Entry file of playwright-core
# for "pins snap" and "pins check".
PLAYWRIGHT_CORE=

# --- Runner (runner/src/runner.js, triad.js, index.js)
# Default off. 1 stops new runs. Only 0 and 1 are valid.
PINS_RUNNER_DISABLED=
# Default <home>/.claude/memory-store/projects. Folder with one <name>/project.json per project.
PINS_PROJECTS_DIR=
# Default the home folder of the service user. Session folder for a pin with no project folder.
PINS_RUNNER_CWD=
# Default /opt/studio/bin:/usr/local/bin:/usr/bin:/bin. PATH of the "before" shot unit.
PINS_SHOT_PATH=
# Default empty. Comma list of host suffixes that the runner leaves alone; each starts with a dot.
PINS_RUNNER_SKIP_HOSTS=
# Default /var/lib/onspot-runner/budget.json. The count of runs started today (UTC).
PINS_RUNNER_BUDGET_FILE=
# Default on. 0 switches the pin brief off. Only 0 and 1 are valid.
PINS_RUNNER_BRIEF=
# Default on. 0 switches the "before" shot by the runner off. Only 0 and 1 are valid.
PINS_RUNNER_SHOTS=
# Default on. 0 switches the lean session start off. Only 0 and 1 are valid.
PINS_RUNNER_LEAN=
# Default /var/lib/onspot-runner/images. Where the runner saves the images of a pin for its session.
PINS_RUNNER_IMAGES_DIR=
# Default http://127.0.0.1:7788. The Triad service; loopback HTTP only.
TRIAD_URL=
# Default /srv/hub/triad/data/token. File that holds the Triad key. The value never goes in an env variable.
TRIAD_TOKEN_FILE=
# Default claude. The Triad account that runs the sessions: claude or claude-2.
PINS_CLAUDE_ACCOUNT=
# Default 0 (no limit). Runs at the same time.
MAX_RUNS=
# Default 0 (no limit). Runs at the same time for one project.
MAX_RUNS_PER_PROJECT=
# Default 0 (no limit). Runs per UTC day.
MAX_RUNS_PER_DAY=

# --- Live checks (e2e/run.mjs)
# Default 70000. Idle time in ms before the live-update check.
E2E_IDLE_MS=
# Default /opt/brave.com/brave/brave-browser. The Brave binary for the "brave" run.
BRAVE_PATH=
# Default ~/.config/onspot/e2e-login.mjs. The login module (not in the repo): it exports
# user (the pin author name) and cookie(apiOrigin) (one playwright cookie for an admin session).
E2E_LOGIN=

# --- Extension build (extension/build.mjs). Optional; with none set the build is the koglabs.com build.
# Default https://ai.koglabs.com/pins. https URL with a plain host name (no *, no IP address,
# no localhost), no query, no fragment, no user, no slash at the end.
ONSPOT_API=
# Default koglabs.com. Host name, lower case, at least one dot. Must equal PINS_ROOT_DOMAIN.
ONSPOT_ROOT_DOMAIN=
# Default <API origin>/triad?tab=pins. https URL with a query.
ONSPOT_QUEUE_URL=
# Default <API origin>/login. https URL without a query.
ONSPOT_LOGIN_URL=
# Default <API origin>/agents?tab=today&run=. https URL; the extension adds the run id.
ONSPOT_RUN_URL=
# Default the file extension/manifest/chrome-key.txt. Public key (base64, one line); it fixes the Chrome id.
ONSPOT_CHROME_KEY=
# Default pins@koglabs.com. The Firefox add-on id: name@host or {UUID}.
ONSPOT_GECKO_ID=

# --- Extension UI harness (npm run harness). Options of one run.
# Default both. chromium or firefox: one browser.
HARNESS_BROWSER=
# Default all groups. audit: only the audit probes.
HARNESS_ONLY=
# Default empty. Only the audit probes whose name holds these words.
HARNESS_PROBE=
# Default extension/src/content/index.js. Another content entry, to see a probe fail on older code.
HARNESS_ENTRY=

# --- Tests only (e2e/lib.test.mjs sets FAKE_START_MS for its fake browser). Never set it yourself.
FAKE_START_MS=

# --- Tests only (server/test/ship-cli.test.js sets them for its fake gh and proj). Never set them yourself.
FAKE_STATE=
FAKE_MERGER=
FAKE_PROJ_LOG=
